@page "/Entrada/Edit/{EntradaId:int}"
@rendermode InteractiveServer

@inject EntradasService entradasService
@inject LibrosService librosService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Modificar Entrada</PageTitle>
<EditForm Model="Entrada" OnValidSubmit="Modificar" FormName="editarEntrada" Context="formContext">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Entrada</h5>
            </div>

            <div class="card-body">

                <div class="d-flex justify-content-between">

                    @* EntradaId *@
                    <div class="mb-3">
                        <label class="form-label"><strong>EntradaId</strong></label>
                        <InputNumber class="form-control" @bind-Value="Entrada.EntradaId" readonly></InputNumber>
                    </div>

                    @* Fecha *@
                    <div class="mb-3">
                        <label class="form-label"><strong>Fecha</strong></label>
                        <InputDate class="form-control" @bind-Value="Entrada.Fecha"></InputDate>
                        <ValidationMessage For="@(() => Entrada.Fecha)" />
                    </div>

                </div>

                @* Concepto *@
                <div class="mb-3">
                    <label class="form-label"><strong>Concepto</strong></label>
                    <InputText class="form-control" @bind-Value="Entrada.Concepto"></InputText>
                    <ValidationMessage For="@(() => Entrada.Concepto)" />
                </div>

                @* Total *@
                <div class="mb-3">
                    <label class="form-label"><strong>Total</strong></label>
                    <InputNumber class="form-control" @bind-Value="Entrada.Total" readonly></InputNumber>
                </div>

                @* Detalles de la Entrada *@
                <div class="border border-success p-3 mt-3">
                    <h5>Detalles de la Entrada</h5>

                    <div class="input-group">

                        <span class="input-group-text">Seleccione:</span>

                        <InputSelect class="form-select" @bind-Value="LibroId">
                            <option value="0">
                                -- Seleccione un libro --
                            </option>

                            @foreach (var libro in ListaLibros)
                            {
                                <option value="@libro.LibroId">
                                    @libro.Titulo
                                </option>
                            }
                        </InputSelect>

                        <span class="input-group-text">Cantidad:</span>

                        <InputNumber class="form-control"
                                     @bind-Value="Cantidad" />

                        <button type="button"
                                class="btn btn-outline-success"
                                @onclick="AgregarLibro">
                            + Agregar
                        </button>

                    </div>

                    <hr />

                    @* Tabla de detalles *@
                    <table class="table table-light">

                        <thead class="table table-striped">
                            <tr>
                                <th>Libro</th>
                                <th>Cantidad</th>
                                <th>Remover</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Entrada.EntradasDetalles)
                            {
                                <tr>
                                    <td>
                                        @ListaLibros.FirstOrDefault(l => l.LibroId == detalle.LibroId)?.Titulo
                                    </td>

                                    <td>@detalle.Cantidad</td>

                                    <td>
                                        <button type="button" class="btn btn-outline-danger bi bi-trash" @onclick="() => QuitarLibro(detalle)"></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <hr />
                </div>

            </div>

            @* footer *@
            <div class="card-footer text-center mb-2">

                <a href="/Entrada/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#eliminarModal"> Eliminar</button>

            </div>

        </div>
    </div>
</EditForm>

@* Modal para confirmar eliminación *@
<div class="modal fade" id="eliminarModal" tabindex="-1" aria-labelledby="eliminarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="eliminarModalLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                ¿Está seguro que desea eliminar esta entrada?
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar"> Eliminar</button>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public int EntradaId { get; set; }

    public Entradas Entrada { get; set; } = new Entradas();
    public List<Libro> ListaLibros { get; set; } = new List<Libro>();

    public int LibroId { get; set; }
    public int Cantidad { get; set; } = 1;

    protected override async Task OnInitializedAsync()
    {
        var result = await entradasService.Buscar(EntradaId);
        Entrada = result.Value!;

        var resultLibros = await librosService.GetList(l => l.LibroId > 0);
        ListaLibros = resultLibros.Value;
    }

    private void AgregarLibro()
    {
        if (LibroId == 0 || Cantidad <= 0)
        {
            toastService.ShowError("Seleccione un libro y una cantidad válida");
            return;
        }

        var detalle = Entrada.EntradasDetalles.FirstOrDefault(d => d.LibroId == LibroId);

        if (detalle != null)
        {
            detalle.Cantidad += Cantidad;
        }
        else
        {
            Entrada.EntradasDetalles.Add(new EntradasDetalle
            {
                EntradaId = Entrada.EntradaId,
                LibroId = LibroId,
                Cantidad = Cantidad
            });
        }

        Entrada.Total = Entrada.EntradasDetalles.Sum(d => d.Cantidad);

        LibroId = 0;
        Cantidad = 1;
    }

    private void QuitarLibro(EntradasDetalle detalle)
    {
        Entrada.EntradasDetalles.Remove(detalle);
        Entrada.Total = Entrada.EntradasDetalles.Sum(d => d.Cantidad);
    }

    private async Task Modificar()
    {
        if (Entrada.EntradasDetalles.Count == 0)
        {
            toastService.ShowError("Debe agregar al menos un libro");
            return;
        }

        Entrada.Total = Entrada.EntradasDetalles.Sum(d => d.Cantidad);

        var result = await entradasService.Guardar(Entrada);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha modificado correctamente");
            navigationManager.NavigateTo("/Entrada/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("No se ha podido modificar correctamente");
        });
    }

    private async Task Eliminar()
    {
        var result = await entradasService.Eliminar(Entrada.EntradaId);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha eliminado correctamente");
            navigationManager.NavigateTo("/Entrada/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("No se ha podido eliminar correctamente");
        });
    }
}
