@page "/Prestamo/Index"
@rendermode InteractiveServer

@inject PrestamosService prestamosService
@inject ToastService toastService

<PageTitle>Registro de Préstamos</PageTitle>

<div class="container">
    <div class="card shadow-lg">

        <div class="card-header d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title">Registro de Préstamos</h5>
            <a href="/Prestamo/Create" class="btn btn-primary"><span class="bi bi-plus-square"></span> Crear</a>
        </div>

        <div class="card-body">

            @* Labels *@
            <div class="row">

                @* Filtrar por *@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @* ValorFiltro *@
                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>

            </div>

            @* Inputs y botones *@
            <div class="row align-items-center">

                @* Filtro *@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opción</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Libro">Libro</option>
                    </InputSelect>
                </div>

                @* Búsqueda *@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

           @* QuickGrid *@
           <div class="grid">
                <QuickGrid Items="ListaPrestamos.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="p => p.PrestamoId" Title="PrestamoId" Sortable="true" />
                    <PropertyColumn Property="p => p.Estudiante!.Nombres" Title="Estudiante" Sortable="true" />
                    <PropertyColumn Property="p => p.Libro!.Titulo" Title="Libro" Sortable="true" />
                    <PropertyColumn Property="p => p.FechaPrestamo" Title="Fecha de Préstamo" Format="dd/MM/yyyy" Sortable="true" />
                    <PropertyColumn Property="p => p.FechaDevolucion" Title="Fecha de Devolución" Format="dd/MM/yyyy" />
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <a href="/Prestamo/Edit/@context.PrestamoId" class="btn btn-outline-primary bi bi-pencil-square"></a>

                        @if (context.FechaDevolucion == null)
                        {
                            <button type="button" class="btn btn-outline-success bi bi-arrow-return-left ms-2" data-bs-toggle="modal" data-bs-target="#modalDevolucion" @onclick="() => MostrarModalDevolucion(context)"></button>
                        }
                    </TemplateColumn>
                </QuickGrid>
            </div>

        </div>

        @* footer *@
        <div class="card-footer d-flex justify-content-between align-items-center">
            <label><strong>Cantidad:</strong> @ListaPrestamos.Count()</label>
            <label><strong>Promedio de días prestados:</strong> @PromedioDiasPrestados.ToString("0.##") días</label>
        </div>

    </div>
</div>

@* Modal de devolución *@
<div class="modal fade" id="modalDevolucion" tabindex="-1" aria-labelledby="modalDevolucionLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalDevolucionLabel">Devolución de Libro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label class="form-label"><strong>Fecha de Devolución</strong></label>
                <InputDate class="form-control" @bind-Value="FechaDevolucion" />
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="ConfirmarDevolucion">Confirmar Devolución</button>
            </div>

        </div>
    </div>
</div>

@code {

    public List<Prestamos> ListaPrestamos { get; set; } = new List<Prestamos>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    private int prestamoADevolver;
    private DateTime FechaDevolucion = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        ListaPrestamos = await prestamosService.GetList(p => p.PrestamoId > 0);
    }

    private double PromedioDiasPrestados
    {
        get
        {
            var prestamosDevueltos = ListaPrestamos
                .Where(p => p.FechaDevolucion.HasValue)
                .ToList();

            if (prestamosDevueltos.Count == 0)
                return 0;

            return prestamosDevueltos.Average(p => (p.FechaDevolucion!.Value.Date - p.FechaPrestamo.Date).TotalDays);
        }
    }

    private void MostrarModalDevolucion(Prestamos prestamo)
    {
        prestamoADevolver = prestamo.PrestamoId;
        FechaDevolucion = DateTime.Today;
    }

    private async Task ConfirmarDevolucion()
    {
        var devuelto = await prestamosService.Devolver(prestamoADevolver, FechaDevolucion);

        if (devuelto)
        {
            toastService.ShowSuccess("Libro devuelto correctamente");
            ListaPrestamos = await prestamosService.GetList(p => p.PrestamoId > 0);
        }
        else
        {
            toastService.ShowError("No se pudo registrar la devolución");
        }
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Estudiante")
            {
                ListaPrestamos = await prestamosService.GetList(p => p.Estudiante!.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Libro")
            {
                ListaPrestamos = await prestamosService.GetList(p => p.Libro!.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
        else
        {
            ListaPrestamos = await prestamosService.GetList(p => p.PrestamoId > 0);
        }
    }
}
