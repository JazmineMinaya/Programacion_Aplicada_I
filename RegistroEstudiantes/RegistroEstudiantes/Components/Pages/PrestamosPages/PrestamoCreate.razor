@page "/Prestamo/Create"

@inject PrestamosService prestamosService
@inject EstudiantesService estudiantesService
@inject LibrosService librosService
@inject NavigationManager navigationManager
@inject ToastService toastService

@*HTML*@
<PageTitle>Create</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Crear Préstamo</h5>
            </div>

            <div class="card-body">

                @*Estudiante*@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-select" @bind-Value="Prestamo.EstudianteId">
                        <option value="0">Elija un estudiante</option>

                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres </option>
                        }
                    </InputSelect>

                    <ValidationMessage For="@(() => Prestamo.EstudianteId)" />

                </div>

                @*Libro*@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-select" @bind-Value="Prestamo.LibroId">
                        <option value="0">Elija un libro</option>

                        @foreach (var libro in ListaLibros)
                        {
                            <option value="@libro.LibroId">
                                @libro.Titulo
                            </option>
                        }
                    </InputSelect>

                    <ValidationMessage For="@(() => Prestamo.LibroId)" />

                </div>

                @*FechaPrestamo*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Préstamo</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo"></InputDate>
                </div>
            </div>

            @*footer*@
            <div class="card-footer text-center mt-2">
                <a href="/Prestamo/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>

                <button type="submit" class="btn btn-primary bi bi-floppy">
                    Guardar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Prestamos Prestamo { get; set; } = new Prestamos()
    {
        FechaPrestamo = DateTime.Today
    };

    public List<Estudiantes> ListaEstudiantes { get; set; } = new();
    public List<Libro> ListaLibros { get; set; } = new();

    public string Mensaje { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.GetList(e => e.EstudianteId > 0);
        ListaLibros = await librosService.GetList(l => l.Disponible == true);
    }

    public async Task Guardar()
    {
        var creado = await prestamosService.Guardar(Prestamo);

        if (creado)
        {
            toastService.ShowSuccess("Préstamo Guardado Correctamente");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se pudo realizar el préstamo");
        }
    }
}